 {
  "name": "qq-farm-bot-ui",
  "version": "20260928",
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "dev:core": "pnpm -C core dev",
    "dev:web": "pnpm -C web dev",
    "dev": "pnpm build:web && pnpm dev:core",
    "lint": "pnpm lint:core && pnpm lint:web",
    "lint:core": "pnpm -C core lint",
    "lint:web": "pnpm -C web lint",
    "typecheck:web": "pnpm -C web typecheck",
    "build:web": "pnpm -C web build",
    "build:core": "pnpm -C core build:ts",
    "build": "pnpm build:web && pnpm build:core",
    "package:win": "pnpm build && pnpm -C core build:win",
    "package:linux": "pnpm build && pnpm -C core build:linux",
    "package:mac": "pnpm build && pnpm -C core build:mac",
    "package:release": "pnpm build && pnpm -C core build:release",
    "install:all": "pnpm install -r --prod=false"
  },
  "pnpm": {
    "overrides": {
      "axios": "^1.20.0",
      "engine.io": "^6.6.7",
      "lodash": "^4.18.1",
      "path-to-regexp": "^0.1.13",
      "picomatch": "^4.0.7",
      "postcss": "^8.5.28",
      "protobufjs": "8.6.6",
      "qs": "^6.16.0",
      "socket.io-parser": "^4.2.7",
      "ws": "^8.21.3",
      "yaml": "^2.8.3"
    }
  }
}
